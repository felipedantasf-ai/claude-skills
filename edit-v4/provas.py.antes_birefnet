"""Provas do formato edit-investigativa: fotos, pessoas, documentos e sites em PRETO E BRANCO com retícula fina,
como no dossiê da referência. Grava em render/assets/ do projeto e roda o make_assets.py.

uso (Python do kit): python provas.py <projeto> ARQ:modo[:largura[:periodo[:gama[:cx[:proporcao]]]]] [...]
  modo      foto      foto de arquivo em tela cheia -> f_<nome>.jpg (padrão: o tamanho que cobre 1080x1920 + 10%, retícula 1:1)
            imp       foto impressa para o MURAL (a borda branca, o canto dobrado e o percevejo são do CSS) -> i_<nome>.jpg (900)
            pessoa    pessoa recortada (U2Net humano do kit), P&B em retícula, fundo transparente -> p_<nome>.png (1000)
                      + posição dos olhos (rosto pelo Haar do OpenCV) em render/olhos.js (tarja preta do recorte())
            multidao  multidão anonimizada: P&B + TARJA PRETA nos olhos de cada rosto detectado -> f_<nome>.jpg (cobre a tela)
            doc       página/print de documento, notícia, diário oficial: cinza com contraste de xerox -> d_<nome>.jpg (1400)
            site      print de site/página com borda RASGADA em cima e embaixo (transparente) -> w_<nome>.png (1100)
  largura   px da imagem final      periodo  px entre os pontos da retícula (padrão 4.5; 0 = sem retícula)
  gama      <1 clareia, >1 escurece (padrão 1)    cx, proporcao  corte na proporção largura/altura, centrado em cx (0..1)
Ex.: python provas.py teste_investigativa fotos/sel/lula.jpg:pessoa fotos/sel/transn.jpg:imp fotos/sel/pedra.jpg:foto::::.5:.5625
Dicas: Git Bash troca "a:b:c" por lista de caminhos -> export MSYS_NO_PATHCONV=1 antes. Retícula: FORCA=.4 (env) é a mistura
dos pontos com a foto (0 = só cinza, 1 = só pontos); a referência usa pontos finos e leves (0,35–0,5).
"""
import json, os, re, subprocess, sys, tempfile, shutil
import numpy as np

# edit-v4: tudo em DUOTONE da V4 (vinho #280000 nas sombras -> cinza-claro #F2F2F2 nas luzes) no lugar do P&B neutro
_V4_ESC, _V4_CLA = np.array([40, 0, 0], np.float32), np.array([242, 242, 242], np.float32)
def duo_v4(g):
    g = np.clip(np.asarray(g, np.float32), 0, 1)[..., None]
    return (_V4_ESC + (_V4_CLA - _V4_ESC) * g).astype(np.uint8)
from PIL import Image, ImageFilter
from scipy import ndimage

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
KIT = os.environ.get("VOX_KIT", "H:/Edição Claude/Kit_Edicao_Vox_v2")   # em outro PC: variável VOX_KIT = pasta do kit
a = sys.argv[1:]
if len(a) < 2:
    sys.exit(__doc__)
P = a[0] if os.path.isabs(a[0]) else os.path.join(KIT, "projetos", a[0])
OUT = os.path.join(P, "render", "assets")
os.makedirs(OUT, exist_ok=True)
FORCA = float(os.environ.get("FORCA", ".42"))
SS = 3
_SESS = {}
PADRAO = {"foto": ("f_", 1400), "imp": ("i_", 900), "pessoa": ("p_", 1000), "multidao": ("f_", 1400), "doc": ("d_", 1400), "site": ("w_", 1100)}


def segmenta(img):
    """máscara de gente (U2Net humano do kit, 320 px)"""
    import onnxruntime as ort
    if "p" not in _SESS:
        so = ort.SessionOptions(); so.intra_op_num_threads = max(2, (os.cpu_count() or 4) // 2)
        _SESS["p"] = ort.InferenceSession(os.path.join(KIT, "modelos", "u2net_human_seg.onnx"), so, providers=["CPUExecutionProvider"])
    sess = _SESS["p"]
    im = np.array(img.convert("RGB").resize((320, 320), Image.LANCZOS)).astype(np.float32)
    im = (im / max(im.max(), 1e-6) - np.array([0.485, 0.456, 0.406])) / np.array([0.229, 0.224, 0.225])
    out = sess.run(None, {sess.get_inputs()[0].name: im.transpose(2, 0, 1)[None].astype(np.float32)})[0][0, 0]
    out = (out - out.min()) / (out.max() - out.min() + 1e-9)
    return Image.fromarray((out * 255).astype(np.uint8), "L").resize(img.size, Image.LANCZOS)


def rostos(img):
    """caixas de rosto (x, y, w, h) pelo Haar do OpenCV (copiado para o %TEMP%: o OpenCV não abre caminho com acento)"""
    import cv2
    dst = os.path.join(tempfile.gettempdir(), "vox_haar_frontalface.xml")
    if not os.path.exists(dst):
        shutil.copy(cv2.data.haarcascades + "haarcascade_frontalface_default.xml", dst)
    cc = cv2.CascadeClassifier(dst)
    g = np.asarray(img.convert("L"))
    m = min(g.shape) // 28
    fs = cc.detectMultiScale(g, scaleFactor=1.08, minNeighbors=5, minSize=(max(18, m), max(18, m)))
    return [tuple(map(int, f)) for f in fs] if len(fs) else []


def meio_tom(cob, periodo, ang=45.0):
    """cob = cobertura de tinta 0..1 -> cobertura dos pontos redondos (0..1), com supersampling"""
    h, w = cob.shape
    y, x = np.mgrid[0:h * SS, 0:w * SS].astype(np.float32) / SS
    c, s = np.cos(np.radians(ang)), np.sin(np.radians(ang))
    u, v = (x * c + y * s) / periodo, (-x * s + y * c) / periodo
    cu, cv = np.floor(u) + .5, np.floor(v) + .5
    du, dv = u - cu, v - cv
    xs, ys = (cu * c - cv * s) * periodo, (cu * s + cv * c) * periodo
    suave = ndimage.gaussian_filter(cob, periodo * .45)
    k = ndimage.map_coordinates(suave, [np.clip(ys, 0, h - 1), np.clip(xs, 0, w - 1)], order=1, mode="nearest")
    t = (du * du + dv * dv) / .5
    lim = np.where(k <= np.pi / 4, 2 * k / np.pi, .5 + .5 * (k - np.pi / 4) / (1 - np.pi / 4))
    return (t < lim).astype(np.float32).reshape(h, SS, w, SS).mean((1, 3))


def pb(img, gama=1.0, sel=None, realce=.55):
    """cinza com contraste de impressão (percentis 1,5–98,5) e realce de borda"""
    g = np.asarray(img.convert("L"), np.float32) / 255
    m = sel if sel is not None else np.ones_like(g, bool)
    lo, hi = np.percentile(g[m], 1.5), np.percentile(g[m], 98.5)
    g = np.clip((g - lo) / max(hi - lo, 1e-3), 0, 1) ** gama
    return np.clip(g + realce * (g - ndimage.gaussian_filter(g, 2.0)), 0, 1)


def reticula(g, per):
    """mistura a foto cinza com a retícula (pontos pretos no claro) na força FORCA"""
    if per <= 0 or FORCA <= 0:
        return g
    dots = 1 - meio_tom(1 - g, per)
    return np.clip(g * (1 - FORCA) + dots * FORCA, 0, 1)


def rasgado(h, w, seed, prof=.022):
    """máscara com borda rasgada em cima e embaixo (fibras de papel)"""
    rng = np.random.default_rng(seed)
    m = np.ones((h, w), np.float32)
    for lado in (0, 1):
        n = w // 6 + 2
        base = np.cumsum(rng.normal(0, 1, n)); base = (base - base.min()) / (np.ptp(base) + 1e-6)
        fino = rng.random(w) * .35
        borda = (np.interp(np.arange(w), np.linspace(0, w - 1, n), base) * .7 + fino) * prof * h + 2
        yy = np.arange(h)[:, None]
        if lado == 0:
            m *= (yy >= borda[None, :]).astype(np.float32)
        else:
            m *= (yy <= h - 1 - borda[None, :]).astype(np.float32)
    return ndimage.gaussian_filter(m, .7)


def processa(spec, olhos):
    parts = spec.split(":")
    if len(parts) > 1 and len(parts[0]) == 1 and parts[1].startswith(("\\", "/")):   # C:\... (letra de unidade)
        parts = [parts[0] + ":" + parts[1]] + parts[2:]
    arq = parts[0] if os.path.isabs(parts[0]) else os.path.join(P, parts[0])
    op = (parts[1:] + [""] * 6)[:6]
    modo = op[0] or "foto"
    if modo not in PADRAO:
        sys.exit(f"modo {modo} desconhecido ({', '.join(PADRAO)})")
    pref, larg0 = PADRAO[modo]
    larg = int(op[1]) if op[1] else larg0
    per = float(op[2]) if op[2] else (3.8 if modo == "pessoa" else 4.5)
    gama = float(op[3] or 1)
    cx = float(op[4]) if op[4] else None
    prop = float(op[5]) if op[5] else None
    nome = pref + os.path.splitext(os.path.basename(arq))[0]
    img = Image.open(arq).convert("RGB")
    if prop:
        W0, H0 = img.size
        if W0 / H0 > prop:
            nw = int(H0 * prop); x0 = int(np.clip((cx if cx is not None else .5) * W0 - nw / 2, 0, W0 - nw))
            img = img.crop((x0, 0, x0 + nw, H0))
        else:
            nh = int(W0 / prop); img = img.crop((0, (H0 - nh) // 2, W0, (H0 - nh) // 2 + nh))
    if modo == "pessoa":
        masc = segmenta(img)
        bb = masc.point(lambda q: 255 if q > 40 else 0).getbbox()
        if bb:
            mg = int(.03 * max(img.size))
            bb = (max(0, bb[0] - mg), max(0, bb[1] - mg), min(img.width, bb[2] + mg), min(img.height, bb[3] + mg))
            img, masc = img.crop(bb), masc.crop(bb)
        k = larg / img.width
        img = img.resize((larg, max(1, round(img.height * k))), Image.LANCZOS)
        masc = masc.resize(img.size, Image.LANCZOS).filter(ImageFilter.GaussianBlur(1.0))
        al = np.asarray(masc, np.float32) / 255
        g = reticula(pb(img, gama, al > .5), per)
        fs = rostos(img)
        if fs:
            x, y, w, h = max(fs, key=lambda f: f[2] * f[3])
            olhos[nome] = [round((x + .1 * w) / img.width, 4), round((y + .27 * h) / img.height, 4),
                           round((x + .9 * w) / img.width, 4), round((y + .5 * h) / img.height, 4)]
        out = np.zeros((*g.shape, 4), np.uint8)
        out[..., :3] = duo_v4(g)
        out[..., 3] = np.clip(al * 255, 0, 255).astype(np.uint8)
        Image.fromarray(out, "RGBA").save(os.path.join(OUT, nome + ".png"), optimize=True)
        print(f"{nome}: pessoa {out.shape[1]}x{out.shape[0]}" + (f" | olhos {olhos[nome]}" if nome in olhos else " | rosto NÃO detectado (tarja manual: [fx0, fy0, fx1, fy1])"))
        return
    if modo in ("foto", "multidao") and not op[1]:           # tela cheia: tamanho que COBRE 1080x1920 com folga de zoom
        larg = round(img.width * max(1188 / img.width, 2112 / img.height))
    k = larg / img.width
    img = img.resize((larg, max(1, round(img.height * k))), Image.LANCZOS)
    if modo == "doc":
        g = np.asarray(img.convert("L"), np.float32) / 255
        lo, hi = np.percentile(g, 2), np.percentile(g, 99.2)
        g = np.clip((g - lo) / max(hi - lo, 1e-3), 0, 1) ** (gama * 1.15)
        g = np.clip(g + .5 * (g - ndimage.gaussian_filter(g, 1.2)), 0, 1)
        g = .06 + g * .86                                                        # papel #dcdbdd, tinta quase preta
        Image.fromarray(duo_v4(g)).save(os.path.join(OUT, nome + ".jpg"), quality=92)
        print(f"{nome}: doc {img.width}x{img.height}")
        return
    g = reticula(pb(img, gama), per)
    if modo == "multidao":
        fs = rostos(img)
        rgb = duo_v4(g)
        for x, y, w, h in fs:
            y0, y1 = int(y + .26 * h), int(y + .5 * h)
            rgb[max(0, y0):y1, max(0, int(x + .04 * w)):int(x + .96 * w)] = (40, 0, 0)   # tarja vinho
        Image.fromarray(rgb).save(os.path.join(OUT, nome + ".jpg"), quality=90)
        print(f"{nome}: multidão {img.width}x{img.height} | {len(fs)} rostos com tarja")
        return
    if modo == "site":
        m = rasgado(img.height, img.width, seed=len(nome) * 7 + 3)
        out = np.zeros((img.height, img.width, 4), np.uint8)
        out[..., :3] = duo_v4(g)
        out[..., 3] = (m * 255).astype(np.uint8)
        Image.fromarray(out, "RGBA").save(os.path.join(OUT, nome + ".png"), optimize=True)
        print(f"{nome}: site {img.width}x{img.height} (borda rasgada)")
        return
    Image.fromarray(duo_v4(g)).save(os.path.join(OUT, nome + ".jpg"), quality=90)
    print(f"{nome}: {modo} {img.width}x{img.height} retícula {per:g}")


oj = os.path.join(P, "render", "olhos.js")
olhos = {}
if os.path.exists(oj):
    m = re.search(r"window\.OLHOS\s*=\s*(\{.*\})", open(oj, encoding="utf-8").read(), re.S)
    if m:
        olhos = json.loads(m.group(1))
for spec in a[1:]:
    processa(spec, olhos)
open(oj, "w", encoding="utf-8").write("window.OLHOS = " + json.dumps(olhos) + ";\n")
if os.path.exists(os.path.join(P, "make_assets.py")):
    r = subprocess.run([sys.executable, "make_assets.py"], cwd=P, capture_output=True, text=True, encoding="utf-8", errors="replace")
    print("make_assets:", (r.stdout or r.stderr).strip()[:100], "...")
